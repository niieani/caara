---
import WhyIllustration from "../WhyIllustration.tsx";

const cells = [
  {
    kind: "pool",
    title: "Every subscription, used to the max",
    body:
      "Your Claude and Antigravity plans carry subsidized usage that idles while you work in Codex. Spawning those agents as subagents spends it, without ever leaving your harness.",
    tone: "mint",
  },
  {
    kind: "focus",
    title: "Save Fable for the hard parts",
    body:
      "Route judgment-heavy work to Claude Fable and let cheaper seats handle execution. A panel with one Fable seat outscores Fable working alone.",
    tone: "plain",
  },
  {
    kind: "review",
    title: "A second model checks the diff",
    body:
      "Cross-family review catches what self-review keeps missing. Gemini reads Claude's work with different habits and different blind spots.",
    tone: "plain",
  },
  {
    kind: "local",
    title: "Local and open",
    body:
      "MIT licensed, served on 127.0.0.1, with every failure mode explicit. Read the source, build it yourself, or install from Homebrew.",
    tone: "copper",
  },
] as const;
---

<section id="why" class="scroll-mt-24 py-20">
  <div class="grid gap-4 sm:grid-cols-2">
    {
      cells.map((cell) => (
        <article
          class:list={[
            "reveal flex items-start gap-6 rounded-lg border p-7 transition-all hover:-translate-y-1",
            cell.tone === "mint" && "border-mint/25 bg-mint/8 hover:border-mint/50",
            cell.tone === "copper" && "border-copper/30 bg-copper/8 hover:border-copper/60",
            cell.tone === "plain" && "border-rule bg-surface hover:border-mint/40",
          ]}
        >
          <div class="min-w-0 flex-1">
            <h3 class="text-lg font-medium tracking-tight">{cell.title}</h3>
            <p class="mt-2.5 text-[15px] leading-relaxed text-muted">{cell.body}</p>
          </div>
          <div
            class="hidden size-24 shrink-0 overflow-hidden rounded-lg border border-rule/60 sm:block"
            aria-hidden="true"
          >
            <WhyIllustration client:only="react" kind={cell.kind} />
          </div>
        </article>
      ))
    }
  </div>
</section>
