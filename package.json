{
  "name": "caara",
  "private": true,
  "bin": {
    "caara": "src/caara.ts"
  },
  "type": "module",
  "module": "src/caara.ts",
  "scripts": {
    "start": "bun src/caara.ts",
    "prepare": "effect-tsgo patch",
    "typecheck": "tsgo -b",
    "lint": "biome lint && oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bunx --bun vitest",
    "test:non-runtime": "bunx --bun vitest --run --project non-runtime",
    "test:profile": "bun scripts/test-speed-profile.ts",
    "test:runtime": "bunx --bun vitest --run --project runtime --project runtime-serial",
    "test:types": "tstyche"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.85",
    "@effect/sql-sqlite-bun": "4.0.0-beta.85",
    "@lensflare.dev/effect": "4.0.0-beta.55",
    "effect": "4.0.0-beta.85"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@catenarycloud/linteffect": "^0.0.6",
    "@effect/ai-openai": "4.0.0-beta.85",
    "@effect/openapi-generator": "4.0.0-beta.85",
    "@effect/platform-node": "4.0.0-beta.85",
    "@effect/tsgo": "0.14.5",
    "@effect/vitest": "4.0.0-beta.85",
    "@types/bun": "1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260621.1",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "tstyche": "^7.2.1",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@effect/platform-node": "4.0.0-beta.85",
    "@effect/platform-node-shared": "4.0.0-beta.85",
    "effect": "4.0.0-beta.85"
  },
  "patchedDependencies": {
    "effect@4.0.0-beta.85": "patches/effect@4.0.0-beta.85.patch"
  }
}
