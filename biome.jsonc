{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "extends": ["@catenarycloud/linteffect"],
  "files": {
    "includes": [
      "src/**/*.ts",
      "!src/**/__experiments__",
      "!temp.local",
      "!data",
      "!references",
      "!node_modules",
      "!coverage",
      "!dist",
      "!build",
    ],
  },
  "linter": {
    "rules": {
      "suspicious": {
        "useIterableCallbackReturn": {
          "level": "error",
          "options": {
            // falsely flags Effect's Sink.forEach callbacks which return Effects
            "checkForEach": false,
          },
        },
      },
    },
  },
  "formatter": {
    "enabled": false,
  },
}
